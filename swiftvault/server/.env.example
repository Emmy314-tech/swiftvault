# SwiftVault server environment configuration
# Copy this file to `.env` (same directory) and fill in real values.
# NEVER commit the real .env file - it is gitignored.

# --- Core ---
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/swiftvault
JWT_SECRET=generate-a-long-random-string

# Restrict API + socket CORS to your real frontend origin(s), comma-separated.
# Required in production; leave unset only for local development.
# CORS_ORIGIN=https://app.example.com

# --- Email (Gmail SMTP used by the email OTP service) ---
EMAIL_USER=
EMAIL_PASS=

# --- Paystack (wallet funding and dedicated accounts) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://app.example.com/wallet/fund
# Live payments remain disabled unless enabled after operational approval.
PAYSTACK_LIVE_PAYMENTS_ENABLED=false
# Exact Paystack-supported preferred bank identifier for DVA assignment.
# Leave unset until the account, KYC, and tier funding policy are approved.
PAYSTACK_DVA_PREFERRED_BANK=

# --- Termii (SMS for OTPs: registration, password reset) ---
TERMII_API_KEY=
TERMII_SENDER_ID=SwiftTalk

# --- Peyflex (VTU: data, airtime, cable, electricity, ePIN, education) ---
PEYFLEX_BASE_URL=https://client.peyflex.com.ng
PEYFLEX_API_TOKEN=

# --- Required for encrypting API credentials stored via the Business Control Center ---
# 32-byte hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=